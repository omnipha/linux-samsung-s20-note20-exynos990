#!/bin/sh
# /init for the c2s rescue initramfs (Samsung Galaxy Note20 Ultra 5G, c2s).
#
# Runs as PID 1. The kernel has already opened /dev/console for our
# stdin/stdout/stderr (console_on_rootfs(), init/main.c) before exec'ing
# this script, so the cpio must carry the /dev/console node. Because
# DEVTMPFS_MOUNT only takes effect inside prepare_namespace(), which is
# never reached for an initramfs boot, every filesystem is mounted here.
#
# Services:
#   - USB device-mode gadget via configfs: NCM + RNDIS + ACM, bound to
#     the Exynos990 DWC3 UDC (drivers/usb/dwc3/dwc3-exynos.c).
#   - dropbear SSH, public-key only, bound to the USB netdev addresses
#     (password/PAM auth compiled out, see dropbear/localoptions.h).
#   - busybox telnetd, debug/rescue opt-in only: RESCUE_ENABLE_TELNET=1
#     in /etc/rescue.conf AND the /etc/enable-telnet marker file.
#
# Console channels:
#   - framebuffer console (/dev/console, console=tty0): what the kernel
#     opened for us before exec'ing this script.
#   - USB ACM serial console (ttyGS0, console=ttyGS0): registered by the
#     kernel when the ACM function instance is created below
#     (gs_console_init(), u_serial.c). Everything this PID 1 writes goes
#     through /dev/kmsg, so a single write fans out to *both* consoles
#     and is kept for `dmesg` over SSH. Kernel and init output are thus
#     readable over the USB cable before, and completely without, the
#     network path - and without any display being present.
#
# Shell: busybox ash (POSIX sh).

export PATH=/usr/bin:/bin:/sbin:/usr/sbin

. /etc/rescue.conf

# ------------------------------------------------------------------ log
# Every init message goes into the kernel ring buffer via /dev/kmsg, from
# where *all* enabled consoles print it: the framebuffer console
# (console=tty0) and the USB ACM serial console (console=ttyGS0). The
# USB console is the rescue channel, so init output must reach it even
# when no display is attached and even when the network path is dead.
#
# /dev/kmsg is used on purpose instead of writing to /dev/ttyGS0
# directly: the USB serial *console* drops what does not fit into its
# 8 KiB buffer (u_serial.c counts the dropped bytes) instead of blocking,
# while a plain write to the tty blocks once the 8 KiB TX buffer is full
# and the host is not reading. A blocked PID 1 would take down the whole
# rescue channel (dropbear, menu, supervision).
#
# The line stays in the ring buffer as well, so `dmesg` over SSH returns
# the complete boot log - including the part that was dropped from the
# 8 KiB USB console buffer.
#
# KMSG can be overridden (used by the host-side verification).
KMSG="${KMSG:-/dev/kmsg}"

log() {
    if [ -w "${KMSG}" ]; then
        echo "c2s-rescue: $*" > "${KMSG}" 2> /dev/null && return 0
    fi
    echo "c2s-rescue: $*"
}

# ---------------------------------------------------------------- mounts
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run
mount -t devpts   devpts   /dev/pts
mount -t tmpfs    tmpfs    /run
mount -t configfs configfs /sys/kernel/config

# --------------------------------------------------------------- gadget
# u_ether defaults to "usb%d"; we pin deterministic names with the
# ifname configfs attribute, which requires exactly one %d
# (gether_set_ifname(), drivers/usb/gadget/function/u_ether.c) and may
# only be written while the function is not linked into a configuration
# (opts->refcnt == 0), i.e. before the ln -s below.
G_UDC=""
G_NCM_IF=""
G_RNDIS_IF=""

# Supervised child PIDs (PID 1 must reap its children itself).
DROPBEAR_PID=""
TELNETD_PID=""
CONSOLE_PID=""

gadget_setup() {
    cfg=/sys/kernel/config/usb_gadget/c2s

    mkdir -p "$cfg" || { log "configfs gadget mkdir failed"; return 1; }

    # Linux Foundation example VID/PID (Documentation/usb/gadget_configfs.rst);
    # deliberately not a Samsung-assigned id.
    echo 0x1d6b > "$cfg/idVendor"
    echo 0x0104 > "$cfg/idProduct"
    echo 0x0100 > "$cfg/bcdDevice"
    echo 0x0200 > "$cfg/bcdUSB"

    mkdir -p "$cfg/strings/0x409"
    echo "c2s rescue"  > "$cfg/strings/0x409/product"
    echo "omnipha"     > "$cfg/strings/0x409/manufacturer"
    echo "c2s-rescue"  > "$cfg/strings/0x409/serialnumber"

    mkdir -p "$cfg/configs/c.1/strings/0x409"
    echo "c2s rescue (NCM+RNDIS+ACM)" \
        > "$cfg/configs/c.1/strings/0x409/configuration"
    # MaxPower is stored in mA; encode_bMaxPower() halves it for
    # high-speed (composite.c), so 500 is the USB 2.0 maximum.
    echo 500 > "$cfg/configs/c.1/MaxPower"

    # ACM FIRST: creating this instance allocates gserial line 0, and
    # gserial_alloc_line() calls gs_console_init() for line 0
    # (drivers/usb/gadget/function/u_serial.c), which register_console()s
    # the ttyGS console with CON_PRINTBUFFER. The kernel replay of the
    # boot log into that console, and therefore every later printk, then
    # goes to the USB serial port - before any network interface exists.
    # The tty device node /dev/ttyGS0 appears here as well (devtmpfs).
    # NCM/RNDIS do not allocate gserial lines, so ACM always is ttyGS0.
    mkdir -p "$cfg/functions/acm.usb2" || return 1
    # Make the console binding explicit (idempotent: gs_console_init()
    # returns immediately if port->console is set). Guarded, because the
    # configfs attribute only exists with CONFIG_U_SERIAL_CONSOLE.
    echo 1 > "$cfg/functions/acm.usb2/console" 2>/dev/null || true

    mkdir -p "$cfg/functions/ncm.usb0"   || return 1
    mkdir -p "$cfg/functions/rndis.usb1" || return 1

    echo "ncm%d"   > "$cfg/functions/ncm.usb0/ifname"   || return 1
    echo "rndis%d" > "$cfg/functions/rndis.usb1/ifname" || return 1

    ln -s "$cfg/functions/ncm.usb0"   "$cfg/configs/c.1/" || return 1
    ln -s "$cfg/functions/rndis.usb1" "$cfg/configs/c.1/" || return 1
    ln -s "$cfg/functions/acm.usb2"   "$cfg/configs/c.1/" || return 1

    # Bind to the UDC last: this enumerates the gadget and registers
    # the u_ether netdevs.
    G_UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1)
    if [ -z "$G_UDC" ]; then
        log "no UDC in /sys/class/udc (dwc3-exynos not probed?)"
        return 1
    fi
    echo "$G_UDC" > "$cfg/UDC" || { log "UDC bind failed"; return 1; }

    # Read the *actual* netdev names now that they are registered.
    G_NCM_IF=$(cat "$cfg/functions/ncm.usb0/ifname")
    G_RNDIS_IF=$(cat "$cfg/functions/rndis.usb1/ifname")
    log "gadget bound to $G_UDC (ncm=$G_NCM_IF rndis=$G_RNDIS_IF)"
    return 0
}

start_dropbear() {
    # -R: generate host keys on first start (none are shipped in the image)
    # -D: directory holding authorized_keys
    # -p: bound to the USB addresses only, never 0.0.0.0
    # -F: stay in the foreground so PID 1 can supervise the process
    dropbear -R -F -E -b /etc/issue -D /root/.ssh -P /run/dropbear.pid \
             -p "$RESCUE_NCM_ADDR:$RESCUE_SSH_PORT" \
             -p "$RESCUE_RNDIS_ADDR:$RESCUE_SSH_PORT" \
             >> /run/dropbear.log 2>&1 &
    DROPBEAR_PID=$!
}

telnet_armed() {
    [ "$RESCUE_ENABLE_TELNET" = "1" ] && [ -f /etc/enable-telnet ]
}

start_telnetd() {
    # Bound to the NCM address only; telnet has no authentication.
    telnetd -F -f /etc/issue -l /bin/sh \
            -b "$RESCUE_NCM_ADDR:$RESCUE_TELNET_PORT" \
            >> /run/telnetd.log 2>&1 &
    TELNETD_PID=$!
}

if gadget_setup; then
    # Static IPv4 per function link: NCM (Linux/macOS) and RNDIS
    # (Windows) are separate links, so they get separate subnets to keep
    # routing unambiguous. Host side uses .2 of the matching subnet.
    ip addr add "$RESCUE_NCM_ADDR/$RESCUE_PREFIX"   dev "$G_NCM_IF"
    ip link set "$G_NCM_IF" up
    ip addr add "$RESCUE_RNDIS_ADDR/$RESCUE_PREFIX" dev "$G_RNDIS_IF"
    ip link set "$G_RNDIS_IF" up
    log "addresses: $G_NCM_IF=$RESCUE_NCM_ADDR $G_RNDIS_IF=$RESCUE_RNDIS_ADDR"

    if [ -s /root/.ssh/authorized_keys ]; then
        chmod 0700 /root/.ssh
        chmod 0600 /root/.ssh/authorized_keys
        mkdir -p /etc/dropbear
        start_dropbear
        log "dropbear up on $RESCUE_NCM_ADDR:$RESCUE_SSH_PORT and $RESCUE_RNDIS_ADDR:$RESCUE_SSH_PORT (pubkey only)"
    else
        log "no /root/.ssh/authorized_keys: dropbear NOT started"
    fi
else
    log "USB gadget setup failed: no network services"
fi

# ------------------------------------------------------------- boot menu
# Selection between "rescue (SSH only, default)" and "rescue + USB
# telnet". The stock c2s bootloader (sboot) offers no menu of its own,
# so the menu lives in this initramfs, which sboot loads from the boot
# image.
#
# Telnet never starts by default. It starts only when the operator
# explicitly selected it in the menu (USB ACM serial "t" or volume
# down), or when it was armed earlier with "rescue-telnet arm" (the
# marker file). The marker wins over the menu, so an armed telnet
# stays armed across reboots until it is disarmed.
boot_menu() {
    if [ -f /etc/enable-telnet ]; then
        log "boot menu: telnet already armed (rescue-telnet arm); keeping it armed"
        return 0
    fi
    mode=$(rescue-menu 2>>/dev/kmsg)
    case "$mode" in
        telnet)
            : > /etc/enable-telnet
            RESCUE_ENABLE_TELNET=1
            log "boot menu: telnet mode selected (USB-only, until rescue-telnet disarm)"
            ;;
        *)
            log "boot menu: rescue mode selected (telnet off)"
            ;;
    esac
}
boot_menu

if telnet_armed; then
    start_telnetd
    log "telnetd up on $RESCUE_NCM_ADDR:$RESCUE_TELNET_PORT (DEBUG MODE, unauthenticated)"
else
    log "telnetd disabled (needs RESCUE_ENABLE_TELNET=1 and /etc/enable-telnet; see rescue-telnet)"
fi

# ------------------------------------------------------- console shell
# Fallback shell on the framebuffer console for when USB is unusable.
# There is currently no input device that reaches this console (no UART
# driver for c2s, only gpio-keys), so it can display but not be typed
# on; it is kept as the last-resort local shell.
spawn_console_shell() {
    setsid cttyhack sh < /dev/console > /dev/console 2>&1 &
    CONSOLE_PID=$!
}
spawn_console_shell

log "init done, entering PID 1 supervision loop"

# -------------------------------------------------------- supervision
# wait -n reaps any child (including ones reparented to PID 1). It
# returns 127 when there is nothing to wait for, so the || sleep 1
# keeps the loop from spinning.
while :; do
    wait -n 2>/dev/null || sleep 1

    if [ -n "$CONSOLE_PID" ] && ! kill -0 "$CONSOLE_PID" 2>/dev/null; then
        log "console shell exited; respawning"
        sleep 1
        spawn_console_shell
    fi

    if [ -n "$DROPBEAR_PID" ] && ! kill -0 "$DROPBEAR_PID" 2>/dev/null; then
        log "dropbear exited; restarting"
        sleep 1
        start_dropbear
    fi

    if [ -n "$TELNETD_PID" ] && ! kill -0 "$TELNETD_PID" 2>/dev/null; then
        if telnet_armed; then
            log "telnetd exited; restarting (debug mode still armed)"
            sleep 1
            start_telnetd
        else
            log "telnetd exited and debug mode is not armed; staying down"
            TELNETD_PID=""
        fi
    fi
done
