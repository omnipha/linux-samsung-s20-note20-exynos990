// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
/*
 * Samsung Galaxy Note20 Ultra 5G (c2s/SM-N986B) device tree source
 *
 * Derived from exynos990-c1s.dts (Igor Belwon). Display, memory and keys
 * taken from c1s/x1s; all device-specific values are untested.
 */

/dts-v1/;
#include "exynos990.dtsi"
#include "c2s-overlay-anchors.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Samsung Galaxy Note20 Ultra 5G";
	compatible = "samsung,c2s", "samsung,exynos990";

	/*
	 * Stock root cell format: lk3rd's add_dt_memory_node() overwrites
	 * /memory reg with 3-cell entries and of_flat_dt_get_addr_size_prop()
	 * only accepts reg blocks whose length is a multiple of
	 * (dt_root_addr_cells + dt_root_size_cells) * 4 == 12 bytes here.
	 * With the previous 2/2 root every 3-cell root-level reg failed the
	 * % 16 test and the kernel saw 0 bytes of RAM (silent death).
	 */
	#address-cells = <2>;
	#size-cells = <1>;

	chosen {
		ranges;
		status = "okay";

		framebuffer0: framebuffer@f1000000 {
			compatible = "simple-framebuffer";
			reg = <0 0xf1000000 (1440 * 3088 * 4)>;
			width = <1440>;
			height = <3088>;
			stride = <(1440 * 4)>;
			format = "a8r8g8b8";
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x3ab00000>,
		      /* Memory hole */
		      <0x0 0xc1200000 0x1ee00000>,
		      /* Memory hole */
		      <0x0 0xe1900000 0x1e700000>,
		      /* Highmem, measured: RAM ends at 0xb00000000.
		       * #size-cells=1 caps each entry at 4 GiB, split into
		       * five 2 GiB chunks (0x880000000..0xb00000000).
		       */
		      <0x8 0x80000000 0x80000000>,
		      <0x9 0x00000000 0x80000000>,
		      <0x9 0x80000000 0x80000000>,
		      <0xa 0x00000000 0x80000000>,
		      <0xa 0x80000000 0x80000000>;
	};

	/* TODO: Remove this once PMIC is implemented */
	reg_dummy: regulator-0 {
		compatible = "regulator-fixed";
		regulator-name = "dummy_reg";
	};

	reserved-memory {
		/* Must equal the root cells: __reserved_mem_check_root(). */
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		cont_splash_mem: framebuffer@f1000000 {
			reg = <0x0 0xf1000000 0x10f6800>;
			no-map;
		};

		/*
		 * Second splash-scanout candidate (see c2s_diag_bands.c).
		 * fb0 and fb1 already live in no-map reservations, so the
		 * C-level ladder could paint them after mm_core_init() while
		 * fb2 stayed ID-map-only: if DECON scans fb2 then every band
		 * from C2 on was invisible regardless of how far the kernel
		 * got, which is the ambiguity the diag7 photo showed (C1
		 * present, C2 absent).  no-map takes 17 MiB of 12 GiB out of
		 * memblock - memblock never owns it, so painting it at any
		 * point after setup_arch() is allocator-safe.
		 */
		fb2_splash_mem: framebuffer@fac00000 {
			reg = <0x0 0xfac00000 0x10f6800>;
			no-map;
		};

		abox_reserved: audio@f7fb0000 {
			reg = <0x0 0xf7fb0000 0x2a50000>;
			no-map;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&key_power &key_voldown &key_volup>;
		pinctrl-names = "default";

		power-key {
			label = "Power";
			linux,code = <KEY_POWER>;
			gpios = <&gpa2 4 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		voldown-key {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa0 4 GPIO_ACTIVE_LOW>;
		};

		volup-key {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa0 3 GPIO_ACTIVE_LOW>;
		};
	};
};

&oscclk {
	clock-frequency = <26000000>;
};

&pinctrl_alive {
	key_power: key-power-pins {
		samsung,pins = "gpa2-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa0-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa0-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
	};
};

&usbdrd {
	status = "okay";
	vdd10-supply = <&reg_dummy>;
	vdd33-supply = <&reg_dummy>;
};

/*
 * The label is deliberately called usbdrd_dwc3_live (not usbdrd_dwc3) so
 * that the stock DTBO entry[7] - which references "usbdrd_dwc3" from
 * stock /__symbols__ and sets dr_mode = "otg", maximum-speed =
 * "super-speed-plus" and the vendor quirk set - lands on the *inert*
 * shell in c2s-overlay-anchors.dtsi, not on this live gadget node.
 * See the note in exynos990.dtsi.
 */
&usbdrd_dwc3_live {
	dr_mode = "peripheral";
	/*
	 * Issue #5 change C - pin the gadget to high-speed, one variable.
	 *
	 * The live node carries only the usb2-phy:
	 *   phys = <&usbdrd_phy 0>;  phy-names = "usb2-phy";
	 * There is no usb3-phy anywhere in this device tree, so a
	 * SuperSpeed link can never be brought up on this port.
	 *
	 * With no "maximum-speed" property, usb_get_maximum_speed()
	 * (drivers/usb/common/common.c:114) returns USB_SPEED_UNKNOWN, and
	 * dwc3/core.c:1949 then replaces it from hwparam_gen() - a hardware
	 * parameter, not something the DT can influence.  If that resolves
	 * to USB_SPEED_SUPER / SUPER_PLUS, __dwc3_gadget_set_speed() writes
	 * DCFG_SUPERSPEED (drivers/usb/dwc3/gadget.c:2592) and the
	 * controller arms itself for a USB 3 link the DT never gave it a
	 * PHY for.
	 *
	 * TWRP enumerates on this same port and cable as high-speed, so
	 * "high-speed" is the speed the hardware has already proven.
	 * usb_get_maximum_speed() matches the string against speed_names[]
	 * (drivers/usb/common/common.c:75), where "high-speed" is
	 * USB_SPEED_HIGH, and dwc3's switch then takes the
	 * case USB_SPEED_HIGH: break; branch (dwc3/core.c:1935), leaving
	 * DCFG at DCFG_HIGHSPEED (drivers/usb/dwc3/gadget.c:2589) instead
	 * of DCFG_SUPERSPEED.
	 *
	 * Only this one property is changed here; no vendor quirk
	 * properties are added alongside it.
	 */
	maximum-speed = "high-speed";
};

&usbdrd_phy {
	status = "okay";
	/* phy-exynos5-usbdrd.c: exynos990_usbdrd_phy sets
	 * .regulator_names = exynos5_regulator_names = { "vbus",
	 * "vbus-boost" } and n_regulators = 2; probe() bulk-gets both
	 * (devm_regulator_bulk_get) and defers forever if either is
	 * missing. Supply a dummy regulator so the PHY driver probes and
	 * the gadget can bind.  Evidence: drivers/phy/samsung/
	 * phy-exynos5-usbdrd.c:1989-1991 (exynos5_regulator_names),
	 * 2097-2108 (exynos990_usbdrd_phy), 3001-3015 (probe bulk-get).
	 * The real VBUS/booster rails (MUIC path) are still unknown, so
	 * these dummies only unblock the driver probe, not actual VBUS
	 * switching.  See c2s-rescue/docs/evidence.md.
	 */
	vbus-supply = <&reg_dummy>;
	vbus-boost-supply = <&reg_dummy>;
};
